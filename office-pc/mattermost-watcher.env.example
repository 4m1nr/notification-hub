# Office Mattermost watcher — install as
# /etc/notification-hub/mattermost-watcher.env (0600).
#
# Works with a regular account: a Personal Access Token is all it needs, no admin
# rights on the Mattermost instance.

MATTERMOST_URL=https://mattermost.office.example.com
MATTERMOST_TOKEN=

# Notify on anything that mentions you, anywhere.
MATTERMOST_NOTIFY_MENTIONS=true
# Notify on direct and group messages.
MATTERMOST_NOTIFY_DMS=true
# Additionally watch these channels wholesale. Use the channel's URL slug
# (the last path segment in its link), not its display name. Comma-separated.
MATTERMOST_CHANNELS=

NTFY_URL=https://ntfy.example.com
NTFY_TOKEN_MATTERMOST=
NTFY_TOPIC_MATTERMOST=mattermost

HC_PING_URL_MATTERMOST=
HC_INTERVAL=5m

LOG_LEVEL=info
