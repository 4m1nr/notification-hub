# Office mail watcher — install as /etc/notification-hub/mail-watcher.env (0600).
#
# This file holds your office mail password. It never belongs in git.

# IMAP server, host:port. 993 is implicit TLS, which is what this watcher speaks.
IMAP_SERVER=mail.office.example.com:993
IMAP_USERNAME=you@office.example.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# Certificate verification. Office mail servers are often reached under a name
# their certificate does not carry, and signed by the company's own CA. Fix
# that properly rather than disabling verification:
#   IMAP_TLS_SERVER_NAME  the name the certificate IS valid for (the error
#                         message lists them), verified against instead of the
#                         host in IMAP_SERVER
#   IMAP_TLS_CA_FILE      PEM file with the internal CA (or the server's own
#                         self-signed certificate) to trust
#   IMAP_TLS_INSECURE     true to skip verification entirely. Last resort: the
#                         mail password then travels to whoever answers on 993.
IMAP_TLS_SERVER_NAME=
IMAP_TLS_CA_FILE=
IMAP_TLS_INSECURE=false

# The hub. Only outbound HTTPS is needed — no VPN.
NTFY_URL=https://ntfy.example.com
NTFY_TOKEN_MAIL=
NTFY_TOPIC_MAIL=mail

# Dead-man's-switch. Leave empty to disable; the watcher runs fine without it,
# you just lose the alert when it stops.
HC_PING_URL_MAIL=
HC_INTERVAL=5m

LOG_LEVEL=info
