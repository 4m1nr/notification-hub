# Office mail watcher — install as /etc/notification-hub/mail-watcher.env (0600).
#
# This file holds your office mail password. It never belongs in git.

# IMAP server, host:port. 993 is implicit TLS, which is what this watcher speaks.
IMAP_SERVER=mail.office.example.com:993
IMAP_USERNAME=you@office.example.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# The hub. Only outbound HTTPS is needed — no VPN.
NTFY_URL=https://ntfy.example.com
NTFY_TOKEN_MAIL=
NTFY_TOPIC_MAIL=mail

# Dead-man's-switch. Leave empty to disable; the watcher runs fine without it,
# you just lose the alert when it stops.
HC_PING_URL_MAIL=
HC_INTERVAL=5m

LOG_LEVEL=info
