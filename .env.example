# notification-hub — VPS configuration.
#
# Copy to /etc/notification-hub/hub.env (mode 0600, owned by root) and fill in
# the values marked REQUIRED. The installers generate everything else and append
# it here on first run, so this file grows as you install components.
#
#   sudo install -d -m 0750 /etc/notification-hub
#   sudo install -m 0600 .env.example /etc/notification-hub/hub.env
#   sudo "${EDITOR:-vi}" /etc/notification-hub/hub.env

#-----------------------------------------------------------------------------
# Domains — REQUIRED. Each must already resolve to this VPS before you issue
# certificates for it.
#-----------------------------------------------------------------------------
NTFY_DOMAIN=ntfy.example.com
MINIFLUX_DOMAIN=rss.example.com
CD_DOMAIN=watch.example.com
HC_DOMAIN=checks.example.com
SYSLOG_DOMAIN=logs.example.com

# Email for Let's Encrypt expiry notices — REQUIRED.
ACME_EMAIL=you@example.com

#-----------------------------------------------------------------------------
# Certificates
#-----------------------------------------------------------------------------
# Force renewal when a certificate is within this many days of expiry. The stock
# certbot behaviour is 30 days; this system checks every 6 hours instead, so a
# much tighter window still leaves ~12 retry opportunities.
CERT_RENEW_THRESHOLD_DAYS=3

# When queued restarts are applied, once daily. Renewals never restart anything
# themselves — they only queue.
CERT_RESTART_TIME=04:30:00

# systemd unit of your separate TLS tunnel service, if you have one. Leave empty
# if not; the "tunnel" entries in domains.map are then skipped.
TUNNEL_SERVICE_UNIT=

#-----------------------------------------------------------------------------
# Syslog
#-----------------------------------------------------------------------------
SYSLOG_TLS_PORT=6514
# Alert threshold: 0 emerg, 1 alert, 2 crit, 3 err, 4 warning, 5 notice, 6 info,
# 7 debug. Alerts fire at this severity and anything more severe. 4 keeps routine
# info/notice chatter off your phone.
SYSLOG_SEVERITY_MAX=4
# Identical messages are suppressed for this long, and no more than
# SYSLOG_MAX_PER_MINUTE notifications are sent in any minute.
SYSLOG_DEDUP_WINDOW=1m
SYSLOG_MAX_PER_MINUTE=12

#-----------------------------------------------------------------------------
# Backups — REQUIRED before running 95-backup.sh
#-----------------------------------------------------------------------------
# Public age recipient. Generate the keypair OFF this machine:
#     age-keygen -o backup-key.txt
# then copy only the "public key:" line here. Keeping the private key off the
# VPS is the whole point — if the VPS is lost, the backups are still readable.
AGE_RECIPIENT=

# Telegram bot token from @BotFather, and the chat to send to. Use a PRIVATE
# chat or channel; add the bot to it and read the id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKUP_TIME=03:30:00
BACKUP_RETENTION_DAYS=3

#-----------------------------------------------------------------------------
# healthchecks.io ping URLs.
#
# Fill these in after creating the checks (see docs/healthchecks-setup.md).
# An empty value disables that dead-man's-switch; the service still runs.
#-----------------------------------------------------------------------------
HC_PING_URL_MAIL=
HC_PING_URL_MATTERMOST=
HC_PING_URL_RSS=
HC_PING_URL_SYSLOG=
HC_PING_URL_BACKUP=
HC_INTERVAL=5m

#-----------------------------------------------------------------------------
# Service listen addresses — change only if a port conflicts.
#-----------------------------------------------------------------------------
RSS_RELAY_LISTEN=127.0.0.1:8181

#-----------------------------------------------------------------------------
# Generated automatically — do not fill these in by hand.
#
# The installers append them on first run and reuse them afterwards, so re-runs
# are idempotent and credentials stay stable:
#
#   PG_NTFY_PASSWORD, PG_MINIFLUX_PASSWORD, PG_HEALTHCHECKS_PASSWORD
#   NTFY_URL, NTFY_PHONE_PASSWORD, NTFY_PUBLISHER_PASSWORD
#   NTFY_TOKEN_MAIL, NTFY_TOKEN_MATTERMOST, NTFY_TOKEN_RSS, NTFY_TOKEN_SYSLOG,
#   NTFY_TOKEN_SYSTEM, NTFY_TOKEN_BACKUP, NTFY_TOKEN_SITECHANGES
#   MINIFLUX_ADMIN_USERNAME, MINIFLUX_ADMIN_PASSWORD, MINIFLUX_WEBHOOK_SECRET
#   HC_SECRET_KEY
#-----------------------------------------------------------------------------
